# Modelo sem valores reais. Copie para .streamlit/secrets.toml (ignorado pelo
# Git) e preencha localmente, ou cole o conteúdo em Manage app -> Settings ->
# Secrets no Streamlit Cloud. Nenhum valor real deve ser versionado.
#
# As chaves são de NÍVEL RAIZ de propósito: o Streamlit expõe apenas segredos
# de raiz como variáveis de ambiente, e é assim que Settings.from_env() as lê.
# Chaves dentro de tabelas como [supabase] não chegariam à configuração.

# --- Supabase ---------------------------------------------------------------
# Settings -> API Keys (o Project URL aparece na mesma tela e no botão Connect).
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"

# Chave pública do cliente de autenticação, formato sb_publishable_...
# Substitui a antiga anon key.
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_SUA_CHAVE"

# Chave privilegiada, formato sb_secret_... Substitui a antiga service_role.
# Ignora RLS. Usada SOMENTE em operações administrativas explícitas (criar
# conta de aluno, redefinir senha). Nunca em consulta de aluno, nunca no
# navegador, nunca em log.
SUPABASE_SECRET_KEY = "sb_secret_SUA_CHAVE"

# Conexão ao PostgreSQL para as transações do ledger.
# Connect -> Direct -> Connection Method: URI -> Type: Session pooler.
# O host correto contém "pooler" e a porta é 5432. A Direct connection é IPv6
# e NÃO funciona no Streamlit Cloud; a Transaction pooler (6543) não aceita
# prepared statements.
# Troque postgresql:// por postgresql+psycopg:// e faça percent-encoding da
# senha se ela tiver caracteres como @ # / : ?
#
# Prefira a mesma região do Streamlit Cloud (EUA). O aluno não fala com o
# banco: quem consulta é o Streamlit, várias vezes por rerun. Um banco no
# Brasil adicionaria ida e volta EUA<->Brasil em cada consulta.
SUPABASE_DB_URL = "postgresql+psycopg://postgres.SEU-REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# O login é por nome de usuário. O app monta internamente usuario@dominio para
# falar com o Supabase Auth; o aluno nunca vê esse endereço.
SUPABASE_USERNAME_DOMAIN = "robonaticos7565.invalid"

# --- Supabase Storage -------------------------------------------------------
# Bucket PRIVADO. As credenciais são as mesmas do Supabase acima: upload e
# download de aluno usam o JWT dele, para as políticas de storage.objects
# valerem. A chave secreta nunca é usada nessas operações.
STORAGE_BUCKET = "student-files"

# Travas contra cobrança. A franquia gratuita é de 1 GB de espaço e 10 GB de
# egress por mês, e não existe teto que pause o serviço: o limite é aplicado
# pela aplicação. Valores acima da franquia são recusados no startup.
STORAGE_MAX_TOTAL_BYTES = "524288000"
STORAGE_MAX_MONTHLY_EGRESS_BYTES = "2147483648"

# --- Aplicação --------------------------------------------------------------
# ATENÇÃO: todo valor deste arquivo é escrito como STRING, entre aspas,
# inclusive os que parecem booleano ou número. A aplicação lê configuração por
# os.environ, e o Streamlit só promove para lá valores str, int e float — um
# `false` booleano do TOML fica só em st.secrets e nunca vira variável de
# ambiente. O resultado é uma chave que parece configurada e não configura
# nada, e o valor que vale passa a ser o default do código.
#
# Em produção a aplicação exige a configuração completa do Supabase acima e
# recusa subir sem ela: identidade, dados e arquivos vivem todos lá.
APP_ENV = "production"

# Popula cinco alunos marcados como Demo, com envios e pontuação sintéticos.
# É opt-in: sem a chave, ou com qualquer valor diferente de "true", nada é
# semeado. Mantenha "false" em qualquer ambiente ligado a um Supabase real.
SEED_FAKE_DATA = "false"

# Primeiro administrador. É criado uma única vez, no Supabase Auth, e nunca
# sobrescrito depois — se já existe um administrador ativo, estas variáveis
# são ignoradas. A aplicação não guarda esta senha em lugar nenhum: ela é
# entregue ao Auth no momento da criação da conta.
BOOTSTRAP_ADMIN_NAME = "Nome do Administrador"
BOOTSTRAP_ADMIN_USERNAME = "admin"
BOOTSTRAP_ADMIN_PASSWORD = "troque-esta-senha-no-primeiro-acesso"
