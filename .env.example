# Modelo sem valores reais. Copie para .env (ignorado pelo Git) e preencha
# localmente. Nenhum valor real deve ser versionado.
#
# Os nomes aqui são exatamente os que english_leaderboard/config.py lê. O teste
# tests/test_config_examples.py falha se os dois lados divergirem — foi assim
# que SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY ficaram meses documentados
# depois de a aplicação já ler outros nomes.

# Ambiente: development | test | production
APP_ENV=development

# --- Supabase ---------------------------------------------------------------
# Em produção estas quatro são obrigatórias e a aplicação recusa subir sem
# elas: identidade, dados e arquivos vivem todos no Supabase.
SUPABASE_URL=

# Chave pública do cliente de autenticação, formato sb_publishable_...
# Substituiu a antiga anon key; o nome antigo não é mais lido.
SUPABASE_PUBLISHABLE_KEY=

# Chave privilegiada, formato sb_secret_... Substituiu a antiga service_role.
# Ignora RLS: usada somente em operação administrativa explícita (criar conta,
# redefinir senha). Nunca em consulta de aluno, nunca no navegador, nunca em log.
SUPABASE_SECRET_KEY=

# Conexão ao PostgreSQL para as transações do ledger.
# Connect -> Direct -> Connection Method: URI -> Type: Session pooler.
# O host correto contém "pooler". A Direct connection é IPv6 e não funciona no
# Streamlit Cloud; a Transaction pooler (6543) não aceita prepared statements.
# Troque postgresql:// por postgresql+psycopg:// e faça percent-encoding da
# senha se ela tiver caracteres como @ # / : ?
SUPABASE_DB_URL=

# O login é por nome de usuário. O app monta internamente usuario@dominio para
# falar com o Supabase Auth; o aluno nunca vê esse endereço.
SUPABASE_USERNAME_DOMAIN=robonaticos7565.invalid

# --- Supabase Storage -------------------------------------------------------
# Bucket PRIVADO. Upload e download de aluno usam o JWT dele, para as políticas
# de storage.objects valerem.
STORAGE_BUCKET=student-files
# Travas contra cobrança: a franquia gratuita é 1 GB de espaço e 10 GB de
# egress por mês, e não existe teto que pause o serviço.
STORAGE_MAX_TOTAL_BYTES=524288000
STORAGE_MAX_MONTHLY_EGRESS_BYTES=2147483648

# --- Primeiro administrador -------------------------------------------------
# Criado uma única vez no Supabase Auth e nunca sobrescrito depois. A aplicação
# não guarda esta senha: ela é entregue ao Auth na criação da conta. As três
# variáveis são definidas juntas ou nenhuma delas.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Desenvolvimento local --------------------------------------------------
# Banco de desenvolvimento, usado apenas quando SUPABASE_DB_URL está vazia.
# Quando ela está definida, é ela que a aplicação usa.
DATABASE_URL=sqlite:///./data/app.db
# Cria cinco alunos marcados como Demo e histórico sintético idempotente.
# Mantenha false em qualquer ambiente ligado a um Supabase real.
SEED_FAKE_DATA=false

# --- Limites de upload ------------------------------------------------------
# Orçamentos defensivos por arquivo, por submissão e por documento expandido.
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=10
MAX_UPLOAD_TOTAL_BYTES=31457280
MAX_PDF_PAGES=10
MAX_DOCUMENT_EXPANDED_BYTES=52428800
MAX_PDF_RENDER_PIXELS=24000000
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=320
MIN_LAPLACIAN_VARIANCE=18
PHASH_DISTANCE_THRESHOLD=6
AUTO_APPROVE_CONFIDENCE=0.88
SUMMARY_MIN_CHARS=120

# --- Google Sheets ----------------------------------------------------------
# Espelho automático opcional. Na arquitetura oficial, o PostgreSQL é a fonte
# de verdade e uma falha do Google nunca desfaz um lançamento.
GOOGLE_SHEETS_AUTO_SYNC=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADERBOARD_TAB=Leaderboard
GOOGLE_SHEETS_LEDGER_TAB=Ledger

# --- SMTP -------------------------------------------------------------------
# Os lembretes por e-mail saíram de escopo em 30 de agosto de 2026 e nenhum
# código consome estas variáveis hoje. Elas continuam sendo lidas por
# Settings.from_env(), então o exemplo as documenta; deixá-las vazias é o
# esperado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=English Activities
SMTP_USE_TLS=true

# --- Variáveis de terceiros -------------------------------------------------
# Não são lidas por Settings.from_env(): quem as consome é o Streamlit ou a
# biblioteca do Google. Estão declaradas em TERCEIROS_PERMITIDOS no teste dos
# exemplos.

# Streamlit limita o lote em MB, além da validação por arquivo da aplicação.
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=30
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# Caminho do JSON da conta de serviço, sempre fora do repositório.
# Em infraestrutura Google, prefira Application Default Credentials e não
# defina esta variável.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
