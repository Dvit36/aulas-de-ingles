# Ambiente: development | test | production
APP_ENV=development

# Modo demo é apenas local. A aplicação recusa production + true.
DEMO_AUTH_ENABLED=true
DEMO_STUDENT_USERNAME=aluno.demo
DEMO_ADMIN_USERNAME=admin.demo
# Cria cinco alunos marcados como Demo e histórico sintético idempotente.
SEED_FAKE_DATA=true

# Autenticação local fechada. No primeiro início, se ainda não existir nenhum
# administrador, estas três variáveis criam a conta inicial uma única vez.
LOCAL_AUTH_ENABLED=true
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Em Docker Compose, use /data/db e /data/uploads.
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads

# Allowlist do modo OIDC legado, separada por vírgulas. ADMIN_USERNAMES deve
# ser subconjunto de ALLOWED_USERNAMES. Só é usada com LOCAL_AUTH_ENABLED=false.
ALLOWED_USERNAMES=aluno@equipe.org,admin@equipe.org
ADMIN_USERNAMES=admin@equipe.org

# Orçamentos defensivos por arquivo, por submissão e por documento expandido.
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=10
MAX_UPLOAD_TOTAL_BYTES=31457280
MAX_PDF_PAGES=10
MAX_DOCUMENT_EXPANDED_BYTES=52428800
MAX_PDF_RENDER_PIXELS=24000000
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=320
MIN_LAPLACIAN_VARIANCE=18
PHASH_DISTANCE_THRESHOLD=6
AUTO_APPROVE_CONFIDENCE=0.88
SUMMARY_MIN_CHARS=120

# Streamlit limita o lote em MB, além da validação por arquivo da aplicação.
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=30
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Copie .streamlit/secrets.toml.example para secrets.toml e preencha no OIDC.
STREAMLIT_SECRETS_FILE=./.streamlit/secrets.toml

# Espelho automático opcional no Google Sheets. O banco local continua sendo
# a fonte de verdade. Crie a planilha, compartilhe-a com a conta de serviço e
# informe somente o ID entre /d/ e /edit na URL.
GOOGLE_SHEETS_AUTO_SYNC=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADERBOARD_TAB=Leaderboard
GOOGLE_SHEETS_LEDGER_TAB=Ledger

# Caminho do JSON da conta de serviço, sempre fora do repositório.
# Em infraestrutura Google, prefira Application Default Credentials e não
# defina esta variável.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Caminho no host usado somente pelo overlay docker-compose.google.yml.
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json

# Lembretes SMTP. Permanecem desativados e em dry-run até que o administrador
# habilite a configuração pela interface e REMINDER_DRY_RUN seja false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=English Activities
SMTP_USE_TLS=true
REMINDER_DRY_RUN=true
REMINDER_SCHEDULER_INTERVAL_SECONDS=300
