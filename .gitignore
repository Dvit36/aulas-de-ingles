.DS_Store
.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Dados persistentes e temporários
data/
uploads/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
tmp/
backups/
import-reports/

# Segredos Streamlit; o exemplo permanece versionável.
# O padrão cobre variantes como secrets.cloud.toml e secrets.local.toml.
.streamlit/secrets*.toml
!.streamlit/secrets.toml.example

# Credenciais externas nunca entram no repositório
secrets/
*service-account*.json
*service_account*.json

# Materiais fornecidos podem conter dados pessoais e não entram na imagem/repo
inputs/
.codex-audit-*/
frontend-atual/
frontend-atual.zip

# Relatórios gerados pelas ferramentas de migração
migration-report.json

# Senhas geradas na migração. Arquivo temporário, para distribuir aos alunos e
# apagar em seguida; senha em claro não entra no Git em hipótese nenhuma.
migration-credentials.json
